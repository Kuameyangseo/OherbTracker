{
  "name": "@oherb-tracker/web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "dev:pm2": "next dev -p 3100",
    "build": "node scripts/build-next.cjs",
    "start": "next start"
  },
  "nx": {
    "targets": {
      "serve": {
        "continuous": true,
        "executor": "nx:run-commands",
        "options": {
          "command": "npm run dev",
          "cwd": "apps/web"
        }
      },
      "build": {
        "executor": "nx:run-commands",
        "outputs": [
          "{projectRoot}/.next"
        ],
        "options": {
          "command": "npm run build",
          "cwd": "apps/web"
        }
      },
      "start": {
        "continuous": true,
        "executor": "nx:run-commands",
        "options": {
          "command": "npm run start",
          "cwd": "apps/web"
        }
      }
    }
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "^15.2.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22"
  }
}
